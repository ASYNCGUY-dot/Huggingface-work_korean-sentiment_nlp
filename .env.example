# ==========================================================
# 환경변수 템플릿
# 이 파일을 복사해서 파일명을 ".env" 로 바꾼 뒤 값을 채우세요.
#   복사 명령: copy .env.example .env
#
# ★ .env 파일은 절대 GitHub / 허깅페이스에 올리지 마세요.
#    (토큰이 유출되면 남이 내 계정으로 배포할 수 있습니다)
# ==========================================================

# 허깅페이스 액세스 토큰 (5일차 Spaces 배포에 필요)
# 발급: https://huggingface.co/settings/tokens
# 권한: Repository - Write 로 생성해야 push가 됩니다.
#
# 🚨 실제 토큰은 여기(.env.example)가 아니라 .env 에 넣으세요.
#    이 파일은 "빈 양식"이라 git에 올라갑니다. .env 만 .gitignore로 보호됩니다.
HUGGINGFACE_TOKEN=hf_여기에_토큰_붙여넣기

# OpenAI API 키 (5일차 voicetest 예제 - 선택 사항)
# 키가 없으면 이 줄은 비워두고, 대체 실습(whisper+m2m100)을 하면 됩니다.
OPENAI_API_KEY=
